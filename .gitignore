# ---- Generati: non si committano ----
# supabase/.temp/ e' della CLI (versione, project ref letto dal link)
supabase/.temp/
# parte*.sql e apply_all.sql sono l'output di supabase/apply/build_chunks.ps1.
# Si rigenerano con un comando: committarli fa finire nel repo copie che
# divergono dalle migration e che nessuno ricontrolla.
supabase/apply/parte*.sql
supabase/apply/apply_all.sql
supabase/apply_all.sql

