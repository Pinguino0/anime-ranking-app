# ---- Generati: non si committano ----
# supabase/.temp/ e' della CLI (versione, project ref letto dal link)
supabase/.temp/
# parte*.sql e apply_all.sql sono l'output di supabase/apply/build_chunks.ps1.
# Si rigenerano con un comando: committarli fa finire nel repo copie che
# divergono dalle migration e che nessuno ricontrolla.
supabase/apply/parte*.sql
supabase/apply/apply_all.sql
supabase/apply_all.sql

# ---- Segreti: MAI committare ----
.env
.env.*
!.env.example
*.pem
*.key
service_role*
sb_secret_*
# Cartella dei segreti locali (es. la service account FCM). La uso io per
# leggere le chiavi una volta e caricarli come secret Supabase: il contenuto
# non deve mai finire nel repo.
.secrets/

# ---- Flutter / Dart ----
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/.packages
client/build/
client/coverage/
client/android/.gradle/
client/android/local.properties
client/android/app/debug/
client/android/app/profile/
client/android/app/release/
client/ios/Pods/
client/ios/.symlinks/
client/ios/Flutter/ephemeral/
client/ios/Flutter/Generated.xcconfig
client/ios/Flutter/flutter_export_environment.sh
client/windows/flutter/ephemeral/
client/macos/Pods/
client/linux/flutter/ephemeral/

# ---- IDE ----
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db

# ---- Logs / temporanei ----
*.log
tmp/
temp/

# ---- APK ----
# Le build debug sono da 200 MB: nel repository occuperebbero piu' di tutto il
# resto del codice insieme, e non servono a nessuno. La build si rifa con
# `flutter build apk --debug`, che usa il codice committato.
*.apk

# I font de Google Fonts sono dentro `client/assets/fonts` e vanno versionati:
# senza, la build su un'altra macchina uscirebbe con i font di sistema.

# ---- Screenshot e log di sessione ----
# Gli screenshot adb servono a guardare l'app mentre si sviluppa: sono
# immagini di una versione precisa, non documentazione, e invecchiano senza
# avvisare. build/ e' quello di root (quello dentro client/ e' gia' coperto
# dalla regola client/build/ piu' sopra).
build/
# Il log di `flutter run` e' testo di Terminale, non un file di progetto.
client/buildapp_log.txt

# ---- Residui di un tentativo Next.js ----
# RESUME.md dice perche' il progetto e' Flutter e Next.js era escluso dal
# vincolo. Se questi file ricompaiono sono un'altra implementazione parallela,
# non una parte dell'app: nessuna rota li importa, e package-lock.json vuoto
# senza package.json non e' nemmeno un progetto installabile.
/components/
/hooks/
/pages/
/package-lock.json

# ---- Scraper Node ----
# node_modules dello scraper: ricreabile con `npm install` in scraper/, non va
# versionato. Gli script (animeunity.js, seed/*.js) invece servono alla CI.
scraper/node_modules/
# Le cache dei seed (es. recall_hentaiworld_cache.json) sono risposte gia' viste
# da AniList: si rigenerano dal primo giro, e committarle aggiunge rumore che
# nessuno rilegge.
scraper/seed/*_cache.json
